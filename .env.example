# `docker compose up` needs no .env file. Database credentials are generated
# into a Docker volume on first run. Copy this file to .env only to change
# the settings below. Never commit .env.

# mock (default): replay recorded model responses; no API key needed.
# live: call the model API with your own key. Nothing calls a model yet.
MODEL_MODE=mock
# Only read in live mode. Never commit a real key.
ANTHROPIC_API_KEY=

# Tiling, read by the worker. A tile is TILE_SIZE pixels square, sized for the
# detector's input; neighbouring tiles overlap by TILE_OVERLAP pixels.
TILE_SIZE=640
TILE_OVERLAP=128
# The largest decoded photo the worker will open. Raise it only together with
# the worker's memory limit in compose.yaml.
MAX_IMAGE_PIXELS=50000000
# The most tiles cut from one photo; a long thin image would otherwise need thousands.
MAX_TILES_PER_PHOTO=512
TILE_JPEG_QUALITY=85
# Jobs the worker runs at once. Decoding a 50-megapixel photo peaks near 500 MB, so
# each extra job needs about that much more memory than the worker's limit in compose.yaml.
WORKER_CONCURRENCY=1
# A job's lock; a job that runs longer is given up on and retried.
JOB_LOCK_SECONDS=300
# How often the worker removes abandoned uploads and dead sessions, and how old an
# upload must be to count as abandoned (never less than 15 minutes).
CLEANUP_INTERVAL_SECONDS=300
ABANDONED_UPLOAD_SECONDS=3600

# The address you open the web app at: the only browser origin the API and the
# object store accept requests from. Add others (comma-separated) only if you
# reach the app by another name, for example localhost.
ALLOWED_ORIGINS=http://127.0.0.1:4700
